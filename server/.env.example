# Copy to .env and edit. NEVER commit the real .env.

# HTTP + WebSocket listen port (behind nginx/caddy in production)
PORT=8080

# Bind address. Keep 127.0.0.1 when a reverse proxy terminates TLS in front.
HOST=127.0.0.1

# Secret used to sign subscription JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret

# Subscription price shown to clients (cents). €5.00 = 500.
SUBSCRIPTION_PRICE_CENTS=500
SUBSCRIPTION_CURRENCY=EUR

# How long an issued subscription token stays valid.
SUBSCRIPTION_TTL_DAYS=30

# Free messages allowed per NEW contact before a subscription is required.
FREE_MESSAGES_PER_CONTACT=20

# Comma-separated allowed origins for the REST API (CORS). * for dev only.
CORS_ORIGINS=*
