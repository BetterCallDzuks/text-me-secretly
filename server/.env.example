# Copy to .env and edit. NEVER commit the real .env.

# HTTP + WebSocket listen port (behind nginx/caddy in production)
PORT=8080

# Bind address. Keep 127.0.0.1 when a reverse proxy terminates TLS in front.
HOST=127.0.0.1

# --- Subscription token signing (RS256) ------------------------------------
# Tokens are signed with an RSA private key and verified by peers OFFLINE with
# the public key. If these files don't exist, the server generates a 2048-bit
# keypair on first boot and writes them here.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# Optional legacy HS256 secret, used only by the /api/verify fallback path.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Subscription price shown to clients (cents). €5.00 = 500.
SUBSCRIPTION_PRICE_CENTS=500
SUBSCRIPTION_CURRENCY=EUR

# How long an issued subscription token stays valid.
SUBSCRIPTION_TTL_DAYS=30

# Free messages allowed per NEW contact before a subscription is required.
FREE_MESSAGES_PER_CONTACT=20

# --- Stripe (real payment gateway) -----------------------------------------
# ALL OPTIONAL. Leave blank to keep the built-in MOCK gateway (auto-pays, needs
# no keys/network — the default for dev and tests). Set STRIPE_SECRET_KEY AND
# STRIPE_PRICE_ID to switch /api/subscribe to real Stripe Checkout; payment is
# then confirmed asynchronously by the webhook below.
#
# Secret API key (sk_test_... in dev, sk_live_... in prod).
STRIPE_SECRET_KEY=
# Signing secret for the webhook endpoint (whsec_...). From the Stripe
# dashboard or `stripe listen`. Required to verify POST /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=
# The recurring Price to subscribe the customer to (price_...), mode=subscription.
STRIPE_PRICE_ID=
# Where Stripe redirects the browser after a completed / cancelled checkout.
STRIPE_SUCCESS_URL=http://localhost:8080/subscribe/success
STRIPE_CANCEL_URL=http://localhost:8080/subscribe/cancel

# --- ICE / TURN (NAT traversal) --------------------------------------------
# Comma-separated STUN URLs (defaults to Google STUN if unset).
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN URLs. Leave empty to run STUN-only (no relay fallback).
#   e.g. turn:turn.your-host.example:3478?transport=udp,turns:turn.your-host.example:5349?transport=tcp
TURN_URLS=

# Shared secret matching coturn `static-auth-secret`. Required for TURN.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURN_SECRET=

# TTL for issued ephemeral TURN credentials (seconds).
TURN_TTL_SECONDS=86400

# Comma-separated allowed origins for the REST API (CORS). * for dev only.
CORS_ORIGINS=*
